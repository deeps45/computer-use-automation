  "outcomeRules": [
    {
      "id": "validation_error",
      "when": {
        "textPresent": "Validation error"
      },
      "outcome": "business_outcome",
      "code": "validation_error",
      "message": "Opening-deposit/nickname validation failed on the sub-account form -- caller should resubmit with corrected inputs."
    },
    {
      "id": "expired_confirmation",
      "when": {
        "textPresent": "invalid or has expired"
      },
      "outcome": "hard_failure",
      "code": "confirmation_expired",
      "message": "The confirmation token expired or was already used."
    },
    {
      "id": "not_found",
      "when": {
        "textPresent": "does not exist in the core"
      },
      "outcome": "business_outcome",
      "code": "member_not_found",
      "message": "No member exists in the core for the given ID."
    },
    {
      "id": "session_timeout",
      "when": {
        "urlPattern": "/login",
        "textPresent": "session expired"
      },
      "outcome": "recoverable",
      "code": "session_expired",
      "message": "Session expired mid-flow.",
      "recovery": {
        "type": "retry",
        "maxAttempts": 1,
        "waitMs": 500
      }
    },
    {
      "id": "server_error",
      "when": {
        "statusCodeAtLeast": 500
      },
      "outcome": "hard_failure",
      "code": "app_error",
      "message": "Target application returned a server error."
    }
  ],
  "successCheckpoint": {
    "description": "Success screen shown with new sub-account number after confirming account creation.",
    "urlPattern": "/members/"
  },
  "risk": {
    "hasIrreversibleSteps": true,
    "irreversibleStepIds": [
