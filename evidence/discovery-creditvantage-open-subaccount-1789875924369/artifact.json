{
  "schemaVersion": "1.0",
  "id": "creditvantage.open-subaccount",
  "name": "Open a member sub-account",
  "description": "Logs in, opens a new sub-account for a member (type, nickname, opening deposit), confirms the irreversible creation step, and reports the new account number.",
  "version": 1,
  "createdAt": "2026-09-20T03:46:18.174Z",
  "provenance": {
    "discoveredBy": "llm",
    "model": "claude-sonnet-5",
    "discoveryRunId": "discovery-creditvantage-open-subaccount-[REDACTED-CC]"
  },
  "target": {
    "appId": "creditvantage",
    "label": "CreditVantage Servicing Console (mock)",
    "baseUrl": "http://localhost:4173",
    "allowedOrigins": [
      "http://localhost:4173"
    ]
  },
  "inputs": [
    {
      "name": "memberId",
      "type": "string",
      "required": true,
      "description": "Member to open the sub-account for.",
      "example": "12345"
    },
    {
      "name": "accountType",
      "type": "string",
      "required": true,
      "description": "Savings or Checking.",
      "example": "Savings"
    },
    {
      "name": "nickname",
      "type": "string",
      "required": true,
      "description": "Display nickname for the new sub-account.",
      "example": "Trip Fund"
    },
    {
      "name": "openingDeposit",
      "type": "number",
      "required": true,
      "description": "Opening deposit amount in USD; must be >= 25.",
      "example": "100"
    }
  ],
  "outputs": [
    {
      "name": "new_account_number",
      "type": "string",
      "description": "New account number is shown on the success screen as required by the goal."
    }
  ],
