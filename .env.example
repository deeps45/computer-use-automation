# Copy to .env (or export directly) before running. Never commit a real .env.

# Required for the automated discovery path (src/agent/discovery-loop.ts / `npm run discover`).
ANTHROPIC_API_KEY=

# Model id used by the automated discovery loop.
MODEL_ID=claude-sonnet-5

# "Secrets" the target app's login form needs -- resolved at run time via
# src/guardrails/secrets.ts, never written into a saved artifact. This is a demo app;
# any non-empty values work.
CVSS_USERNAME=ops_agent
CVSS_PASSWORD=demo-pass

# Run browsers headless (true) or headed/visible (false, default) -- headed lets a human
# literally see and use the live session during an escalation.
HEADLESS=false

# Ports for the local services.
TARGET_APP_PORT=4173
OPERATOR_PORT=4200
DISCOVER_PORT=4300
