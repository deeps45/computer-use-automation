# Copy to .env (or export directly) before running. Never commit a real .env.

# Automated discovery needs ONE of these two provider configs (cli/discover.ts picks
# whichever is set; ANTHROPIC_API_KEY takes precedence if both are).

# Option A: Anthropic directly (src/agent/discovery-loop.ts).
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5

# Option B: any OpenAI-compatible chat-completions gateway (src/agent/discovery-loop-openai-compat.ts).
# Expects POST {OPENAI_COMPAT_BASE_URL}/chat/completions in OpenAI's request/response shape.
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=protected.Claude Sonnet 4.5

# "Secrets" the target app's login form needs -- resolved at run time via
# src/guardrails/secrets.ts, never written into a saved artifact. This is a demo app;
# any non-empty values work.
CVSS_USERNAME=ops_agent
CVSS_PASSWORD=demo-pass

# Run browsers headless (true) or headed/visible (false, default) -- headed lets a human
# literally see and use the live session during an escalation.
HEADLESS=false

# Ports for the local services.
TARGET_APP_PORT=4173
OPERATOR_PORT=4200
DISCOVER_PORT=4300
